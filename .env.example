# Application
NODE_ENV=development
PORT=3000

# API Configuration
API_URL=
API_KEY=

# Database (Neon PostgreSQL - Recommended)
# Sign up at https://neon.tech and create a project
# Copy the connection string from your Neon dashboard
# Example: postgresql://username:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://username:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Alternative: Local PostgreSQL
# If using local PostgreSQL instead of Neon:
# DATABASE_URL=postgresql://user@localhost:5432/selfy_v3

# Authentication (NextAuth)
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here-generate-with-openssl
NEXTAUTH_URL=http://localhost:3000

# OAuth Providers (Optional)
# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email Provider (Resend - for transactional emails)
# Sign up at https://resend.com and get API key
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Selfy Photo Booth

# SMS Provider (Twilio - for SMS notifications)
# Sign up at https://twilio.com and get credentials
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Workflow Automation (Inngest)
# Sign up at https://inngest.com and create an app
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=your-inngest-signing-key
INNGEST_ENDPOINT=http://localhost:3000/api/inngest

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# External Services
# Cloudinary (for design template assets and thumbnails)
# Sign up at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Vercel (Auto-populated in Vercel deployment)
VERCEL_URL=
VERCEL_ENV=

# Feature Flags
# FEATURE_FLAG_NAME=false
